{
  "name": "linkclump",
  "version": "1.2.3",
  "description": "Lets you open, copy or bookmark multiple links at the same time.",
  "type": "module",
  "scripts": {
    "build": "rsbuild build --mode=development",
    "build:prod": "rsbuild build --mode=production",
    "build:watch": "rsbuild build --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carry0987/Linkclump.git"
  },
  "keywords": [
    "chrome-extension",
    "typescript",
    "preact",
    "tailwindcss",
    "vitest",
    "rsbuild"
  ],
  "author": "carry0987",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carry0987/Linkclump/issues"
  },
  "homepage": "https://github.com/carry0987/Linkclump#readme",
  "dependencies": {
    "@uiw/react-color": "^2.9.6",
    "preact": "^10.29.0",
    "tailgrids": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@carry0987/utils": "^3.10.3",
    "@rsbuild/core": "^1.7.3",
    "@rsbuild/plugin-preact": "^1.7.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.1.38",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "4.1.1",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.2",
    "vitest": "^4.1.1"
  }
}
