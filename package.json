{
  "name": "linkclump-neo",
  "version": "1.5.0",
  "description": "Lets you open, copy or bookmark multiple links at the same time.",
  "type": "module",
  "scripts": {
    "build": "rsbuild build --mode=development",
    "build:prod": "rsbuild build --mode=production",
    "build:watch": "rsbuild build --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carry0987/Linkclump.git"
  },
  "keywords": [
    "chrome-extension",
    "typescript",
    "preact",
    "tailwindcss",
    "vitest",
    "rsbuild"
  ],
  "author": "carry0987",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carry0987/Linkclump/issues"
  },
  "homepage": "https://github.com/carry0987/Linkclump#readme",
  "dependencies": {
    "@uiw/react-color": "^2.10.3",
    "preact": "^10.29.3",
    "tailgrids": "^2.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@carry0987/utils": "^3.10.3",
    "@rsbuild/core": "^2.1.1",
    "@rsbuild/plugin-preact": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
